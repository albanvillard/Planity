rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Par défaut, refuser tous les accès non explicitement autorisés
    match /{document=**} {
      allow read, write: if false;
    }

    // Règles de sécurité pour les blocs de temps (time_blocks)
    match /time_blocks/{blockId} {
      // Lecture, modification et suppression autorisées uniquement si l'utilisateur est connecté 
      // et qu'il est le propriétaire du document existant (userId)
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Création autorisée uniquement si l'utilisateur est connecté 
      // et qu'il s'attribue lui-même la propriété du document (userId)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Règles de sécurité pour la collection des utilisateurs (users)
    match /users/{userId} {
      // Lecture, écriture et suppression autorisées uniquement si l'utilisateur est propriétaire du document
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}